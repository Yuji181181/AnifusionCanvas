# Shared local development example.
# Copy to .env and replace values for real database, storage, and AI calls.

APP_ENV=development
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080

# memory keeps the demo vertical slice local. Use database after applying migrations.
STUDIO_STORE=memory

# Go MySQL driver DSN. Required in production and when STUDIO_STORE=database.
DATABASE_URL=

# Cloudflare R2. Required for real image/video storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=
R2_REGION=auto

# Replicate API token. Required for real ToonCrafter / Inpainting inference.
REPLICATE_API_TOKEN=
