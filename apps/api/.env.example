APP_ENV=development
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# memory is the default for local demo runs. Use database after applying migrations.
STUDIO_STORE=memory

# Go MySQL driver DSN. Required in production and when STUDIO_STORE=database.
DATABASE_URL=

# Cloudflare R2. Required for real image/video storage and dependency health checks.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=
R2_REGION=auto

# Replicate API token. Required for real ToonCrafter / Inpainting inference.
REPLICATE_API_TOKEN=

# Replicate model versions. Defaults shown are the latest available aliases.
# Lock to a specific hash in production to avoid breaking changes.
REPLICATE_TOONCRAFTER_VERSION=fofr/tooncrafter
REPLICATE_SDXL_INPAINTING_VERSION=lucataco/sdxl-inpainting
